# `pnpm web` (dev) falls back to the local stack below. A production build (`pnpm build`, `pnpm deploy:web`) uses
# only what is set here: without an RPC and a policy URL it publishes the simulations alone and calls no localhost.

# Base RPC the dashboard reads from.
VITE_BASE_RPC_URL=http://127.0.0.1:8546
# Chain id whose deployment (contracts/deployments/<id>.json) to use: 31337 local, 84532 Base Sepolia, 8453 Base.
VITE_CHAIN_ID=31337
# Policy signer API.
VITE_POLICY_URL=http://127.0.0.1:8787
