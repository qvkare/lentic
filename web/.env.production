# What the public site (lentic.qvkare.com) reads: the Base Sepolia deployment in
# contracts/deployments/84532.json, through publicnode's Base Sepolia RPC (CORS open; log queries are
# split into windows it accepts). No policy signer URL:
# the signer's party routes are not public, so stations show LoanBook's record and key turns.
VITE_CHAIN_ID=84532
VITE_BASE_RPC_URL=https://base-sepolia-rpc.publicnode.com
